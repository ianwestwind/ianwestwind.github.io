// ============================================================
// Multimodal Intelligence Lab — Firestore Security Rules
//
// Deploy via: firebase deploy --only firestore:rules
// Or paste directly in Firebase Console → Firestore → Rules
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helper functions ----

    // Is the request from an authenticated user?
    function isAuth() {
      return request.auth != null;
    }

    // Fetch the caller's role from the users collection (safe if doc missing)
    function callerRole() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return !exists(path)
        ? 'guest'
        : get(path).data.get('role', 'regular');
    }

    // Role hierarchy check: caller's role must be >= required
    // Roles: guest(0) < visitor(1) < regular(2) < moderator(3) < admin(4)
    // Accepts lowercase or capitalized role (e.g. "admin" or "Admin")
    function hasRole(required) {
      let rank = {
        'guest': 0,
        'visitor': 1, 'Visitor': 1,
        'regular': 2, 'Regular': 2,
        'moderator': 3, 'Moderator': 3,
        'admin': 4, 'Admin': 4
      };
      let role = callerRole();
      return isAuth() && role in rank && required in rank && rank[role] >= rank[required];
    }

    // Is the caller the owner of the document?
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }


    // ---- /users/{uid} ----
    match /users/{uid} {
      // A member can read the directory. Anyone can read their own profile.
      allow read: if isOwner(uid) || hasRole('regular');

      // A user can create their own document (registration)
      // They may NOT set themselves a privileged role
      allow create: if isOwner(uid)
        && request.resource.data.role == 'visitor'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'role', 'institution', 'title', 'createdAt'])
        && request.resource.data.institution is string
        && request.resource.data.institution.size() > 0
        && request.resource.data.institution.size() <= 120
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120;

      function storedRole() {
        return resource.data.get('role', 'regular').lower();
      }

      function regularClassOf() {
        return request.resource.data.get('regularClass', '');
      }

      function supervisorOk() {
        let sid = request.resource.data.get('supervisorId', '');
        let sup = /databases/$(database)/documents/users/$(sid);
        return sid == ''
          || (
            request.resource.data.role == 'regular'
            && regularClassOf() in ['b', 'c']
            && sid != uid
            && exists(sup)
            && get(sup).data.get('role', '') == 'regular'
            && (
              (regularClassOf() == 'b' && get(sup).data.get('regularClass', '') == 'a')
              || (regularClassOf() == 'c' && get(sup).data.get('regularClass', '') in ['a', 'b'])
            )
          );
      }

      function placementOk() {
        return request.resource.data.role == 'regular'
          ? ((regularClassOf() == '' || regularClassOf() in ['a', 'b', 'c']) && supervisorOk())
          : (regularClassOf() == '' && request.resource.data.get('supervisorId', '') == '');
      }

      // A user can update their own profile fields except role.
      // Email may change only to the address on their Auth token.
      // Admin can reassign anyone who is not an admin.
      // Moderator can reassign only regular members and visitors, and only to those two roles.
      allow update: if
        (isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('moderatorId', '') == resource.data.get('moderatorId', '')
          && request.resource.data.get('regularClass', '') == resource.data.get('regularClass', '')
          && request.resource.data.get('supervisorId', '') == resource.data.get('supervisorId', '')
          && (request.resource.data.email == resource.data.email
              || request.resource.data.email == request.auth.token.email))
        ||
        (hasRole('admin')
          && storedRole() != 'admin'
          && request.resource.data.role in ['visitor', 'regular', 'moderator', 'admin']
          && placementOk())
        ||
        (hasRole('moderator')
          && storedRole() in ['visitor', 'regular']
          && request.resource.data.role in ['visitor', 'regular']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'regularClass', 'supervisorId'])
          && (
            (request.resource.data.role == 'visitor'
              && request.resource.data.get('regularClass', '') == '')
            || (request.resource.data.role == 'regular'
              && request.resource.data.regularClass in ['a', 'b', 'c'])
          )
          && (
            request.resource.data.get('supervisorId', '') == ''
            || request.resource.data.supervisorId == resource.data.get('supervisorId', '')
          ));

      // Only admin can delete user documents
      allow delete: if hasRole('admin');
    }


    // ---- /announcements/{id} ----
    match /announcements/{id} {
      // Everyone (including unauthenticated) can read
      allow read: if true;

      // Only moderators and admins can create
      allow create: if hasRole('moderator')
        && request.resource.data.authorUid == request.auth.uid;

      // Only the author (if mod+) or an admin can update
      allow update: if hasRole('admin');

      // Moderator+ can delete any announcement; author can delete their own
      allow delete: if hasRole('moderator')
        || (isAuth() && resource.data.authorUid == request.auth.uid && hasRole('moderator'));
    }


    // ---- /forum_posts/{id} ----
    match /forum_posts/{id} {
      // Everyone can read forum posts
      allow read: if true;

      // Registered users (regular+) can create posts
      allow create: if hasRole('regular')
        && request.resource.data.authorUid == request.auth.uid;

      // Authors can update their own post; moderators/admins can update any
      allow update: if (isOwner(resource.data.authorUid) && hasRole('regular'))
        || hasRole('moderator');

      // Moderators can delete any post; authors can delete their own
      allow delete: if hasRole('moderator')
        || isOwner(resource.data.authorUid);
    }


    // ---- /forum_posts/{postId}/comments/{cid} ----
    match /forum_posts/{postId}/comments/{cid} {
      allow read: if true;
      allow create: if hasRole('regular')
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if (isOwner(resource.data.authorUid) && hasRole('regular'))
        || hasRole('admin');
      allow delete: if hasRole('admin') || isOwner(resource.data.authorUid);
    }


    // ---- /writing_posts/{postId}/comments/{cid} ----
    match /writing_posts/{postId}/comments/{cid} {
      allow read: if true;
      allow create: if hasRole('regular')
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isOwner(resource.data.authorUid) || hasRole('admin');
      allow delete: if hasRole('admin') || isOwner(resource.data.authorUid);
    }


    // ---- /news_posts/{postId}/comments/{cid} ----
    match /news_posts/{postId}/comments/{cid} {
      allow read: if true;
      allow create: if hasRole('regular')
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isOwner(resource.data.authorUid) || hasRole('admin');
      allow delete: if hasRole('admin') || isOwner(resource.data.authorUid);
    }


    // ---- /discussion_posts/{id} ----
    match /discussion_posts/{id} {
      // Everyone can read
      allow read: if true;

      // Registered users can create
      allow create: if hasRole('regular')
        && request.resource.data.authorUid == request.auth.uid;

      // Authors can edit their own post; moderators/admins can edit any
      allow update: if (isOwner(resource.data.authorUid) && hasRole('regular'))
        || hasRole('moderator');

      // Moderators can delete any; authors can delete their own
      allow delete: if hasRole('moderator')
        || isOwner(resource.data.authorUid);
    }


    // ---- /news_posts/{id} ----
    match /news_posts/{id} {
      // Everyone (including unauthenticated) can read published posts
      allow read: if true;

      // Only moderators and admins can create news posts
      allow create: if hasRole('moderator')
        && request.resource.data.authorUid == request.auth.uid;

      // Anyone can increment/decrement likeCount only;
      // author (mod+) or admin can update any field
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        || (isOwner(resource.data.authorUid) && hasRole('moderator'))
        || hasRole('admin');

      // Moderator+ can delete any; author can delete their own
      allow delete: if hasRole('moderator')
        || (isAuth() && resource.data.authorUid == request.auth.uid && hasRole('moderator'));
    }


    // ---- /writing_posts/{id} ----
    match /writing_posts/{id} {
      // Everyone can read
      allow read: if true;

      // Only admins can create writing posts
      allow create: if hasRole('admin')
        && request.resource.data.authorUid == request.auth.uid;

      // Anyone can increment/decrement likeCount only;
      // only an admin can update any other field
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        || hasRole('admin');

      // Only an admin can delete a writing post
      allow delete: if hasRole('admin');
    }


    // ---- /consultation_slots/{id} ----
    match /consultation_slots/{id} {
      // Authenticated users can read slots
      allow read: if isAuth();
      // Only admin can manage slots
      allow create, update, delete: if hasRole('admin');
    }


    // ---- /consultations/{id} ----
    match /consultations/{id} {
      // Admin sees all; requester sees their own
      allow read: if hasRole('admin')
        || (isAuth() && resource.data.requesterUid == request.auth.uid);
      // Regular members and above can request a booking for themselves
      allow create: if hasRole('regular')
        && request.resource.data.requesterUid == request.auth.uid;
      // Only admin can update (approve/reject)
      allow update: if hasRole('admin');
      // Admin or the requester can delete
      allow delete: if hasRole('admin')
        || isOwner(resource.data.requesterUid);
    }


    // ---- /software_projects/{id} ----
    match /software_projects/{id} {
      allow read: if true;
      allow create, update, delete: if hasRole('admin');
    }


    // ---- /design_projects/{id} ----
    match /design_projects/{id} {
      allow read: if true;
      allow create, update, delete: if hasRole('admin');
    }


    // ---- /site_config/{docId} ----
    // Public site configuration (profile, collaborators, etc.)
    match /site_config/{docId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }


    // ---- /visits/{id} ----
    // Anyone can log a visit; only admins can read stats
    match /visits/{id} {
      allow create: if true;
      allow read:   if hasRole('admin');
      allow update, delete: if false;
    }


    // ---- Deny all other paths ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
